            "size": 14785,
            "mimeType": "application/xml",
            "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<MediaContainer friendlyName=\"myPlex\" identifier=\"com.plexapp.plugins.myplex\" machineIdentifier=\"db27d46cc0f696a3b709e79e354d2a3e7fa3e948\" totalSize=\"27\" size=\"27\" title1=\"Announcements\" viewGroup=\"mixed\" content=\"mixed\">\n  <Announcement id=\"101\" title=\"Let the Discussions Begin\" content=\"Keep the conversation going on Plex with discussions—our newest community feature. Download the latest version of the app to get started.&#10;\" plainContent=\"Keep the conversation going on Plex with discussions—our newest community feature. Download the latest version of the app to get started.&#10;\" imageUrl=\"https://assets.plex.tv/announcements/new/discussion-fearture-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1781049600\" read=\"false\"/>\n  <Announcement id=\"100\" title=\"New Lifetime Plex Pass Pricing - Coming Soon \" content=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can. \" plainContent=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can. \" imageUrl=\"https://assets.plex.tv/announcements/plex-icon.png\" style=\"info\" url=\"https://account.plex.tv/checkout/plexpass/?plan=lifetime \" expireAt=\"0\" notifyAt=\"1779285660\" read=\"false\"/>\n  <Announcement id=\"95\" title=\"INTRODUCING LISTS\" content=\"Big news! Now you can create and share lists of your favorite movies, shows, and episodes on Plex! \" plainContent=\"Big news! Now you can create and share lists of your favorite movies, shows, and episodes on Plex! \" imageUrl=\"https://assets.plex.tv/announcements/new/discovery-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1774287960\" read=\"false\"/>\n  <Announcement id=\"94\" title=\"Pro Week is here.\" content=\"The wait is over. New personal media sessions are live. Check ‘em out.\" plainContent=\"The wait is over. New personal media sessions are live. Check ‘em out.&#13;&#10;\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pro-icon.png \" style=\"info\" url=\"https://www.plex.tv/pro-week/ \" expireAt=\"0\" notifyAt=\"1758420000\" read=\"false\"/>\n  <Announcement id=\"93\" title=\"Plex Pro Week is heading out\" content=\"But, our pros aren't going anywhere. Watch the entire lineup of tutorials right here.\" plainContent=\"But, our pros aren't going anywhere. Watch the entire lineup of tutorials right here.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pro-icon.png\" style=\"info\" url=\"https://www.plex.tv/pro-week/\" expireAt=\"0\" notifyAt=\"1726797600\" read=\"false\"/>\n  <Announcement id=\"92\" title=\"Pro Week is (STILL) happening\" content=\"Check out: Does Your Server Suck (Energy)? with Techno Tim and more.\" plainContent=\"Check out: Does Your Server Suck (Energy)? with Techno Tim and more.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pro-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1726711200\" read=\"false\"/>\n  <Announcement id=\"90\" title=\"A Must-Read for Geeks\" content=\"Do you know the story of Geek Pride Day and why it matters? Read all about it—there’s a surprise at the end.\" plainContent=\"Do you know the story of Geek Pride Day and why it matters? Read all about it—there’s a surprise at the end.\" imageUrl=\"https://assets.plex.tv/announcements/new/news-announcement.png\" style=\"info\" url=\"https://www.plex.tv/blog/the-legend-of-the-geek/\" expireAt=\"0\" notifyAt=\"1716238980\" read=\"false\"/>\n  <Announcement id=\"89\" title=\"Skip Intro + Credits + More!\" content=\"Intros and credits can now be skipped automatically (bye-bye button), disabled (for credit lovers), or chosen manually each time via the Skip Credits button.\" plainContent=\"Intros and credits can now be skipped automatically (bye-bye button), disabled (for credit lovers), or chosen manually each time via the Skip Credits button.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pass-perks.png\" style=\"info\" url=\"https://www.plex.tv/plex-pass/\" expireAt=\"0\" notifyAt=\"1703949060\" read=\"false\"/>\n  <Announcement id=\"87\" title=\"What will we Discover Together?\" content=\"Now you can use Discover to search for and add friends, share, rate, comment, and more.\" plainContent=\"Now you can use Discover to search for and add friends, share, rate, comment, and more.\" imageUrl=\"https://assets.plex.tv/announcements/new/discovery-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/discover-together\" expireAt=\"0\" notifyAt=\"1698856020\" read=\"false\"/>\n  <Announcement id=\"86\" title=\"Fireside in the Forums\" content=\"Read the most popular Q&amp;As from our Pro Week pre-party last week.\" plainContent=\"Read the most popular Q&amp;As from our Pro Week pre-party last week.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pro-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/plex-pro-week-23-tldr-our-first-ever-fireside-in-the-forums/\" expireAt=\"0\" notifyAt=\"1695387600\" read=\"false\"/>\n  <Announcement id=\"84\" title=\"We’re Back, Baby\" content=\"Plex Pro Week 2023 is on. All new pros. All new topics. \" plainContent=\"Plex Pro Week 2023 is on. All new pros. All new topics. \" imageUrl=\"https://assets.plex.tv/announcements/new/plex-pro-icon.png\" style=\"info\" url=\"https://www.plex.tv/pro-week/\" expireAt=\"0\" notifyAt=\"1695040860\" read=\"false\"/>\n  <Announcement id=\"78\" title=\"Introducing Skip Credits\" content=\"Now skip credits (or to mid-credits and post-credits) with just a single click. Available for Plex Pass members’ personal media collection and our free on-demand catalog.\" plainContent=\"Now skip credits (or to mid-credits and post-credits) with just a single click. Available for Plex Pass members’ personal media collection and our free on-demand catalog.\" imageUrl=\"https://assets.plex.tv/announcements/new/skip-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/let-the-next-episode-roll/\" expireAt=\"0\" notifyAt=\"1676571900\" read=\"false\"/>\n  <Announcement id=\"70\" title=\"The Streaming Struggle Ends Now\" content=\"Introducing Discover on Plex. Starting today, Plex can search, personalize, and organize all of your content, no matter where it lives—including your favorite streaming services, and any personal media libraries you currently access.\" plainContent=\"Introducing Discover on Plex. Starting today, Plex can search, personalize, and organize all of your content, no matter where it lives—including your favorite streaming services, and any personal media libraries you currently access.\" imageUrl=\"https://assets.plex.tv/announcements/new/discovery-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/end-the-streaming-struggle-with-plex/\" expireAt=\"0\" notifyAt=\"1649129820\" read=\"false\"/>\n  <Announcement id=\"65\" title=\"Cord Cutters, Meet Your New Guide\" content=\"Live TV &amp; DVR Plex Pass users can now access all their channels—plus Plex live TV—from one guide.\" plainContent=\"Live TV &amp; DVR Plex Pass users can now access all their channels—plus Plex live TV—from one guide.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-live-tv-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/cord-cutters-rejoice-all-your-live-tv-all-in-one-place/\" expireAt=\"0\" notifyAt=\"1645817040\" read=\"false\"/>\n  <Announcement id=\"63\" title=\"200 Reasons to Love Live TV\" content=\"Attention US users! You now have access to over 200 free Live TV channels on Plex. Happy surfing!\" plainContent=\"Attention US users! You now have access to over 200 free Live TV channels on Plex. Happy surfing!\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-live-tv-icon-200-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1636720080\" read=\"false\"/>\n  <Announcement id=\"62\" title=\"Introducing Downloads\" content=\"We’ve completely rebuilt—and renamed—our ‘Sync’ feature to be more reliable and intuitive across the board.\" plainContent=\"We’ve completely rebuilt—and renamed—our ‘Sync’ feature to be more reliable and intuitive across the board.\" imageUrl=\"https://assets.plex.tv/announcements/new/downloads-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/going-off-grid-just-got-great/\" expireAt=\"0\" notifyAt=\"1635271020\" read=\"false\"/>\n  <Announcement id=\"59\" title=\"Apple TV and Roku Users\" content=\"It’s time to choose your own layout adventure. Plus find the perfect movie or show faster with fewer clicks.\" plainContent=\"it’s time to choose your own layout adventure. Plus find the perfect movie or show faster with fewer clicks.\" imageUrl=\"https://assets.plex.tv/announcements/new/modern-layout-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/choose-your-own-adventure-introducing-modern-layout/\" expireAt=\"0\" notifyAt=\"1629387060\" read=\"false\"/>\n  <Announcement id=\"58\" title=\"Super Sonic: Get Closer to Your Music\" content=\"Today we’re announcing a massive server upgrade for Plex Pass subscribers who have discovered our awesome dedicated music app, Plexamp.\" plainContent=\"Today we’re announcing a massive server upgrade for Plex Pass subscribers who have discovered our awesome dedicated music app, Plexamp.\" imageUrl=\"https://assets.plex.tv/announcements/new/plexamp-icon.png\" style=\"info\" url=\"https://www.plex.tv/blog/super-sonic-get-closer-to-your-music-in-plexamp/\" expireAt=\"0\" notifyAt=\"1628779080\" read=\"false\"/>\n  <Announcement id=\"57\" title=\"Now Available to Watch on Plex\" content=\"Click for a list of new Plex releases that include Django Unchained, Silver Linings Playbook, Wind River, Lucky Number Slevin, Lara Croft Tomb Raider: The Cradle of Life, Noah, and more.&#13;&#10;\" plainContent=\"Click for a list of new Plex releases that include Django Unchained, Silver Linings Playbook, Wind River, Lucky Number Slevin, Lara Croft Tomb Raider: The Cradle of Life, Noah, and more.&#13;&#10;\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-stream-movies-icon.png\" style=\"info\" url=\"https://watch.plex.tv/\" expireAt=\"0\" notifyAt=\"1627850580\" read=\"false\"/>\n  <Announcement id=\"56\" title=\"Plex Offers Spanish-Language Live TV\" content=\"Sixteen new Spanish-language channels join the existing lineup in Latin America, offering drama, comedy, kids content, music videos, news, lifestyle, and more, available to stream free, 24/7.\" plainContent=\"Sixteen new Spanish-language channels join the existing lineup in Latin America, offering drama, comedy, kids content, music videos, news, lifestyle, and more, available to stream free, 24/7.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-live-tv-icon.png\" style=\"info\" url=\"https://www.plex.tv/tv-gratis/\" expireAt=\"0\" notifyAt=\"1616013000\" read=\"false\"/>\n  <Announcement id=\"55\" title=\"Plex Now Included in Apple TV Search\" content=\"Plex-provided titles are now included in search results from the main Apple TV app! But don’t worry, your personal media titles will stay personal to you and not be displayed in Apple TV search results.\" plainContent=\"Plex-provided titles are now included in search results from the main Apple TV app! But don’t worry, your personal media titles will stay personal to you and not be displayed in Apple TV search results.\" imageUrl=\"https://assets.plex.tv/announcements/new/apple-tv-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1614974940\" read=\"false\"/>\n  <Announcement id=\"54\" title=\"Introducing Free Live TV on Plex\" content=\"&lt;p dir=&quot;ltr&quot;&gt;All-you-can-watch free Live TV is available now. 80+ channels for the whole family, at your fingertips. Kids, news, game shows, anime, sports, cooking&amp;mdash;it&amp;rsquo;s all on Plex and ready for the watching.&lt;/p&gt;\" plainContent=\"All-you-can-watch free Live TV is available now. 80+ channels for the whole family, at your fingertips. Kids, news, game shows, anime, sports, cooking—it’s all on Plex and ready for the watching.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-live-tv-icon.png\" style=\"priority\" url=\"https://www.plex.tv/blog/the-one-where-plex-announces-free-streaming-live-tv/\" expireAt=\"0\" notifyAt=\"1595511420\" read=\"false\"/>\n  <Announcement id=\"53\" title=\"Free Movies &amp; TV from Crackle\" content=\"Starting today, dig into top Hollywood movies and TV shows from Crackle, with well-loved titles spanning all genres and featuring today&amp;rsquo;s hottest stars. All free and available right now. US Only.\" plainContent=\"Starting today, dig into top Hollywood movies and TV shows from Crackle, with well-loved titles spanning all genres and featuring today’s hottest stars. All free and available right now. US Only.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-stream-movies-icon.png\" style=\"info\" url=\"https://mediaverse.plex.tv/\" expireAt=\"0\" notifyAt=\"1588347060\" read=\"false\"/>\n  <Announcement id=\"52\" title=\"Watch 1000s of Free Movies on Plex\" content=\"&lt;span id=&quot;docs-internal-guid-ed3086b8-7fff-463c-da3d-e93cee87537b&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial; font-variant-numeric: normal; font-variant-east-asian: normal; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Start streaming free movies, TV shows, extreme sports, music documentaries, Bollywood musicals, and more in Plex.&lt;/span&gt;&lt;/span&gt;\" plainContent=\"Start streaming free movies, TV shows, extreme sports, music documentaries, Bollywood musicals, and more in Plex.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-stream-movies-icon.png\" style=\"info\" url=\"\" expireAt=\"0\" notifyAt=\"1575495600\" read=\"false\"/>\n  <Announcement id=\"38\" title=\"Plex News now available for all\" content=\"Plex News is here! Watch it anywhere, anytime. Local, National, and Global sources.\" plainContent=\"Plex News is here! Watch it anywhere, anytime. Local, National, and Global sources.\" imageUrl=\"https://assets.plex.tv/announcements/new/plex-news.png\" style=\"info\" url=\"https://www.plex.tv/blog/all-the-news-thats-fit-to-plex/\" expireAt=\"0\" notifyAt=\"1506432060\" read=\"false\"/>\n  <Announcement id=\"96\" title=\"New Lifetime Plex Pass Pricing - Coming Soon\" content=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can.\" plainContent=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can\" imageUrl=\"\" style=\"info\" url=\"https://account.plex.tv/checkout/plexpass/?plan=lifetime \" expireAt=\"0\" notifyAt=\"0\" read=\"false\"/>\n  <Announcement id=\"97\" title=\"New Lifetime Plex Pass Pricing - Coming Soon\" content=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can.\" plainContent=\"The price of a new Lifetime Plex Pass will increase on July 1, 2026. Get yours at the existing price while you still can.\" imageUrl=\"\" style=\"info\" url=\"https://account.plex.tv/checkout/plexpass/?plan=lifetime \" expireAt=\"0\" notifyAt=\"0\" read=\"false\"/>\n</MediaContainer>\n"
          },
